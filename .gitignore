# Локальная конфигурация MCP-клиента (содержит SSH-пути и URL'ы конкретного хоста).
# Уже tracked в исторических коммитах main — не удаляем из tracking, но новые
# изменения в этом файле остаются у разработчика локально.
.mcp.json

# Локальные настройки Claude Code на стороне разработчика
# (settings.json/settings.local.json/permissions). Не часть проекта.
.claude/

# Артефакты playwright-mcp (console-логи + page-снапшоты) — создаются при запуске сервера из этой папки
.playwright-mcp/

# Локальный allowlist аудита секретов (audit_secrets.py). Содержит SHA исторических
# коммитов + комментарии с внутренними деталями инфраструктуры — НЕ публиковать.
.secret-audit-allowlist

# Проприетарные материалы 1С (сборник вопросов 1С:Профессионал, ISBN) + банк
# тестов на его основе. НЕ публиковать на GitHub.
docs/Провессионал/

# Правила для агента Codex — генерируются локально, не часть проекта.
AGENTS.md

# Правила для агента Claude — локальные, описывают внутренний контур выкатки.
CLAUDE.md

# Реестр обследования кодовой базы — внутренний документ: описывает найденные,
# в том числе ещё не закрытые, слабые места. НЕ публиковать на GitHub.
docs/audit-2026-08.md

# Локальные бэкапы файлов перед правкой (foo.rs.bak.20260818_140957). Создаются
# по ходу работы, ценности для репозитория не имеют — исходное состояние и так
# хранит git.
*.bak
*.bak.*

