# Конфиг хука code-index-guard.
#
# Где ищется: рядом с exe (файл code-index-guard.toml в каталоге бинарника),
# либо по пути из переменной окружения CODE_INDEX_GUARD_CONFIG.
#
# Все разделы ниже НЕОБЯЗАТЕЛЬНЫ. Итоговый список индексированных баз хука —
# это сумма (репо из daemon.toml) + ([[local]]) с дедупликацией по пути:
# репо из daemon.toml приоритетны, [[local]] добавляет лишь те пути, которых
# в daemon.toml нет. Если не задано ничего — хук ничего не перехватывает.
#
# Скопируйте этот файл в code-index-guard.toml рядом с exe и отредактируйте.


# ── daemon_toml (опционально) ─────────────────────────────────────────────
# Путь к daemon.toml индексатора code-index. Из него берутся все репо, которые
# индексирует демон. По этим репо (у каждого свой .code-index/index.db) хук
# делает точную пер-файловую проверку и блокирует нативный Read с redirect в
# read_file/get_function; repo-wide Grep/Glob/Bash — в grep_code/list_files.
# Приоритет: env CODE_INDEX_DAEMON_TOML → эта строка. Нет ни того, ни другого —
# daemon.toml не читается.
# daemon_toml = "C:/tools/code-index/daemon.toml"


# ── events_db (опционально) ───────────────────────────────────────────────
# База SQLite событий хука: одна строка на запуск (deny / allow / skip с
# причиной) в таблице hook_events — по ней видно, что хук перехватил и что
# пропустил. Каталог базы должен существовать, файл создаётся сам.
# Нет строки — события не записываются.
# events_db = "C:/Users/<ВашеИмя>/.claude/hooks/hook-events.db"


# ── [[local]] (опционально) ───────────────────────────────────────────────
# Отдельные индексированные репо, добавленные вручную — в дополнение к daemon.toml
# (или вместо него, если daemon_toml не задан). path — корень репо, alias — его
# имя в code-index. Пути, уже присутствующие в daemon.toml, дублировать не нужно —
# они отсеются дедупликацией.
# [[local]]
# path = "C:/Projects/MyApp"
# alias = "myapp"
#
# [[local]]
# path = "C:/Projects/Lib"
# alias = "lib"
